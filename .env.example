# =====================================================
# TK WEBTALENT – UMGEBUNGSVARIABLEN
# Kopiere diese Datei als ".env" und trage deine Werte ein.
# Die .env-Datei darf NIEMALS in Git eingecheckt werden!
#
# Vercel: Variablen im Dashboard unter
# Project → Settings → Environment Variables eintragen.
# =====================================================

# ── SUPABASE ──────────────────────────────────────────
# Aus: Supabase Dashboard → Project Settings → API

# Die Projekt-URL (öffentlich sicher, wird auch im Frontend verwendet)
SUPABASE_URL=https://DEIN-PROJEKT-ID.supabase.co

# Anon-Schlüssel (öffentlich sicher – für Browser/Frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-Role-Schlüssel (STRENG GEHEIM – NUR serverseitig verwenden!)
# Niemals im Frontend oder in einer öffentlichen Datei speichern.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── RESEND (E-Mail-Versand) ──────────────────────────────
# Aus: Resend Dashboard → API Keys

RESEND_API_KEY=re_...

# E-Mail-Adresse, an die Benachrichtigungen (neue Buchungen/Nachrichten) gehen
ADMIN_EMAIL=admin@deine-domain.de

# Absender-Adresse für ausgehende E-Mails (muss bei Resend verifiziert sein)
FROM_EMAIL=noreply@deine-domain.de

# ── ANTHROPIC (KI-Chatbot) ───────────────────────────────
# Aus: console.anthropic.com → API Keys
# Treibt den KI-geführten Anfrage-Chat im #kontakt-Bereich an.

ANTHROPIC_API_KEY=sk-ant-...

# ── PUSHOVER (Push-Benachrichtigung bei neuen Angeboten) ─
# Aus: pushover.net → Ein Konto anlegen, dann eine "Application"
# erstellen (App-Token) → PUSHOVER_APP_TOKEN.
# Der User Key steht auf deiner Pushover-Startseite → PUSHOVER_USER_KEY.
# Sobald der Chatbot ein Angebot vorschlägt, bekommst du sofort eine
# Push-Nachricht aufs Handy mit Link zur Freigabe-Seite.

PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# ── ZOOM ──────────────────────────────────────────────
# Persönlicher Zoom-Meeting-Link (z.B. dein "Personal Meeting Room").
# Wird in Buchungsbestätigungen für Zoom-Termine an Kunde + Admin verschickt.
# Solange nicht gesetzt, bekommen Kunden stattdessen den Hinweis, dass der
# Link separat nachgereicht wird.
ZOOM_MEETING_LINK=https://zoom.us/j/DEINE-MEETING-ID
